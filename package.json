{
  "name": "draft",
  "version": "1.1.1",
  "description": "game client/server",
  "homepage": "https://github.com/dr4fters/dr4ft",
  "bugs": {
    "url": "https://github.com/dr4fters/dr4ft/issues"
  },
  "license": "MIT",
  "author": "Dr4fters Team <zach@dr4ft.info>",
  "contributors": [
    {
      "name": "Zach Halpern",
      "email": "zach@dr4ft.info"
    },
    {
      "name": "Hervé Huneau",
      "email": "herve.huneau@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dr4fters/dr4ft.git"
  },
  "scripts": {
    "start": "node scripts/run",
    "start-dev": "npm run watch & npm run server:watch",
    "start-debug": "npm run watch & npm run server:debug",
    "build": "webpack --config webpack.prod.js",
    "watch": "webpack --config webpack.dev.js --watch --devtool inline-source-map",
    "lint": "eslint .",
    "test": "npm run postinstall && npm run test:js",
    "test:js": "mocha \"./{,!(node_modules|built)/**/}*.spec.*js\" --exit --require @babel/register",
    "postinstall": " npm run download_allsets && npm run download_booster_rules && webpack --config webpack.prod.js",
    "update_database": "node scripts/update_database ",
    "download_allsets": "node scripts/download_allsets",
    "download_booster_rules": "node scripts/download_booster_rules",
    "server:watch": "node --watch ./app.js",
    "server:debug": "node --watch --inspect-brk=1338 ./app.js"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "axios": "^1.12.0",
    "babel-loader": "^10.1.1",
    "body-parser": "^2.4.0",
    "cors": "^2.8.5",
    "dompurify": "^3.2.4",
    "engine.io": "^6.6.4",
    "engine.io-client": "^6.6.3",
    "express": "^5.3.0",
    "express-fileupload": "^1.4.0",
    "fast-xml-parser": "^5.11.2",
    "filepond": "^4.30.4",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.8",
    "fuse.js": "^7.5.0",
    "helmet": "^8.3.0",
    "html-webpack-plugin": "^5.5.0",
    "joi": "^18.3.0",
    "jsonfile": "^6.1.0",
    "lodash": "^4.17.21",
    "node-schedule": "^2.1.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-filepond": "^7.1.2",
    "react-select-search": "^4.1.9",
    "react-tooltip": "^6.0.9",
    "semver": "^7.4.0",
    "unzipper": "^0.12.5",
    "utils": "git://github.com/dr4fters/utils.git",
    "uuid": "^14.0.3",
    "vanilla-toast": "^0.5.0",
    "webpack": "^5.102.0",
    "webpack-merge": "^6.0.1",
    "weighted": "^1.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/register": "^8.0.6",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.30.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "regenerator-runtime": "^0.14.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=9"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
